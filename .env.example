# Copy to .env.local for local development only. Never commit real values.
# In Cloudflare Pages, add sensitive values as encrypted Secrets, not plain vars.

# AI providers (server-side only)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct:featherless-ai
WANDB_API_KEY=
EXAM_RAG_URL=

# Messaging integrations (server-side only)
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# SMS (OTP) — Kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Payment — Zarinpal (production merchant id enables real payments; otherwise MOCK)
APP_URL=
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=

# Optional provider/router settings
CLOUDFLARE_GATEWAY_URL=
AGENTROUTER_API_KEY=

# Optional client SDK configuration. These are public project identifiers,
# never service-role/admin secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LOCAL TESTING ONLY. Never enable this in production; it echoes OTP codes.
DEV_AUTH_CODES=false

# On Cloudflare Pages, D1 is supplied through the DB binding in wrangler.json.
# CF_ACCOUNT_ID / D1_DATABASE_ID / D1_API_TOKEN are only needed by the Vercel
# fallback and should not be configured in the Cloudflare Pages runtime.
CF_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=
