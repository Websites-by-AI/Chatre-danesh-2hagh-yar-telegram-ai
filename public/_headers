# Cloudflare Pages cache headers.
# Hashed build assets are immutable (content-addressed) → cache for a full year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and HTML must always revalidate so new deploys appear.
/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
